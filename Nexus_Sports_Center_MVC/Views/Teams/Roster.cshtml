
@model Nexus_Sports_Center_MVC.ViewModels.TeamRosterViewModel

@{
    ViewData["Title"] = "Manage Roster";
}

<h2>Manage Roster: @Model.Team?.Name</h2>
<h5 class="text-muted mb-4">Home Venue: @(Model.Team?.HomeVenue?.Name ?? "None")</h5>

<div class="row">
    <!-- Left Column: Add New Player Form -->
    <div class="col-md-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Add Player</h5>
            </div>
            <div class="card-body">
                <form asp-action="AddPlayerToRoster" method="post">
                    <!-- Hidden field to link player to this team -->
                    <input type="hidden" asp-for="NewPlayer.TeamId" />

                    <div class="mb-3">
                        <label asp-for="NewPlayer.FirstName" class="form-label">First Name</label>
                        <input asp-for="NewPlayer.FirstName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPlayer.LastName" class="form-label">Last Name</label>
                        <input asp-for="NewPlayer.LastName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPlayer.JerseyNumber" class="form-label">Jersey Number</label>
                        <input asp-for="NewPlayer.JerseyNumber" class="form-control" type="number" />
                    </div>

                    <button type="submit" class="btn btn-success w-100">Add to Team</button>
                </form>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">Back to Teams List</a>
    </div>

    <!-- Right Column: List of Existing Players -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="card-title mb-0">Current Roster</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Jersey #</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ExistingPlayers.Any())
                        {
                            foreach (var player in Model.ExistingPlayers)
                            {
                                <tr>
                                    <td>@(player.JerseyNumber?.ToString() ?? "-")</td>
                                    <td>@player.FirstName</td>
                                    <td>@player.LastName</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">
                                    No players have been added to this team yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
