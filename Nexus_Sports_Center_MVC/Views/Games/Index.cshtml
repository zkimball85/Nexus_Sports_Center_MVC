@model IEnumerable<Nexus_Sports_Center_MVC.Models.Game>

@{
    ViewData["Title"] = "Schedule and Log Games";
}

<h1>Schedule and Log Games</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.GameDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HomeTeam)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AwayTeam)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Venue)
            </th>
            <th>
            <th>
                @Html.DisplayNameFor(model => model.Sport)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Score)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.GameDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.HomeTeam)
            </td>
            <td>
                @Html.DisplayFor(model => item.AwayTeam)
            </td>
            <td>
                @Html.DisplayFor(model => item.Venue)
            </td>
            <td>
                @Html.DisplayFor(model => item.Sport)
            </td>
            <td>
                @Html.DisplayFor(model => item.Score)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
